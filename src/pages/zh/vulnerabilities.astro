---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const vulnerabilities = (await getCollection('vulnerabilities'))
	.sort((a, b) => (b.data.pubDate?.valueOf() || 0) - (a.data.pubDate?.valueOf() || 0));

// TODO: 換成你的 ZeroDay 個人頁網址
const ZERODAY_URL = 'https://zeroday.hitcon.org/';
---

<BaseLayout title="漏洞通報" description="我曾通報過的資安漏洞清單">
	<section class="block">
		<div style="margin-bottom: 2rem;">
			<span style="color: var(--accent-color)">denny@denny.li</span>:<span style="color: var(--dim-color)">~</span>$ ls -la /reports/vulnerabilities
		</div>

		<div class="activity-list">
			{vulnerabilities.length === 0 && <p>查無通報紀錄</p>}
			{vulnerabilities.map(({ data }) => (
				<div class="item-row">
					<div style="display: flex; gap: 1.5rem;">
						<span style="color: var(--dim-color)">{data.pubDate.toISOString().split('T')[0]}</span>
						<span style="color: var(--accent-color); font-weight: bold;">{data.vendor}</span>
						<span style="color: var(--text-color);">{data.title}</span>
						{data.target && <span style="color: var(--dim-color)">@ {data.target}</span>}
					</div>
					<div style="display: flex; align-items: center; gap: 0.8rem; flex-shrink: 0;">
						{data.zeroday && (
							<a href={data.zeroday} target="_blank" rel="noopener noreferrer" class="tag-mini" style="text-decoration: none; color: var(--accent-color); border-color: var(--accent-color);">
								ZeroDay
							</a>
						)}
						{data.status && <span class="tag-mini">{data.status}</span>}
					</div>
				</div>
			))}
		</div>

		<div style="margin-top: 2.5rem; display: flex; flex-wrap: wrap; gap: 1rem;">
			<a href={ZERODAY_URL} target="_blank" rel="noopener noreferrer" class="action-link">--&gt; HITCON ZeroDay</a>
			<a href="/zh" class="action-link">&lt;-- 返回根目錄</a>
		</div>
	</section>
</BaseLayout>
