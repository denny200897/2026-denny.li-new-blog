---
import type { ImageMetadata } from 'astro';
import ThemeBaseHead from '@navfolio/theme-default/components/BaseHead.astro';
import FallbackImage from '../assets/figure/fail-loading-image.png';
import { getSiteConfig } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata | string;
}

const { title, description, image } = Astro.props;
const { site, fonts } = await getSiteConfig();
---

<ThemeBaseHead
  title={title}
  description={description}
  image={image}
  fallbackImage={FallbackImage}
  site={site}
  fonts={fonts}
/>

<script is:inline>
  // Carry the current theme onto the incoming document so view transitions
  // do not flash the light background before the theme script runs again.
  (() => {
    if (window.__navfolioThemeSwapBound) return;
    window.__navfolioThemeSwapBound = true;

    document.addEventListener('astro:before-swap', (event) => {
      const theme = document.documentElement.dataset.theme;
      if (!theme) return;

      const incoming = event.newDocument.documentElement;
      incoming.dataset.theme = theme;
      incoming.style.colorScheme = theme;
    });
  })();
</script>
